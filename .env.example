# Copy to .env on the server:  cp .env.example .env
# Used by docker compose. Do not commit .env.

DB_NAME=TMS_PROD_CLIENT
DB_USER=taskflow_client
DB_PASSWORD=change-this-db-password

JWT_SECRET=change-this-to-a-long-random-string

# Live site origin(s), comma-separated, no trailing slash
CORS_ORIGIN=https://jppco.in,https://www.jppco.in

# Baked into the frontend image at build time. Rebuild web if you change these.
NEXT_PUBLIC_API_URL=https://jppco.in/api
NEXT_PUBLIC_WS_URL=https://jppco.in

APP_NAME=TaskFlow
OTP_EXPIRY_MINUTES=10
MAX_UPLOAD_BYTES=26214400

# Optional mail (leave empty if unused)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
